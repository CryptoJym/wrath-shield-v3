  "sync_rules": {
    "default_sync_interval_minutes": 30,
    "status_mapping": {
      "motion_to_github": {
        "COMPLETED": "closed",
        "IN_PROGRESS": "open",
        "TODO": "open",
        "BACKLOG": "open"
      },
      "github_to_motion": {
        "closed": "COMPLETED",
        "open": "TODO"
      }
    },
    "priority_mapping": {
      "motion_to_github": {
        "URGENT": ["urgent", "critical"],
        "HIGH": ["high", "priority"],
        "MEDIUM": [],
        "LOW": ["low"],
        "NONE": []
      }
    },
    "conflict_resolution": "last_write_wins_motion_priority"
  }
}
