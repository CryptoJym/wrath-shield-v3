{
  "version": 2,
  "_note": "Motion integration deprecated as of 2024-12. All task management now uses GitHub.",
  "github": {
    "organizations": [
      {
        "id": "org_cryptojym",
        "name": "CryptoJym",
        "description": "Infrastructure, FCRA tools, and personal projects",
        "default_domain": "personal_private"
      },
      {
        "id": "org_h3ro",
        "name": "h3ro-dev",
        "description": "Production products and Of One ecosystem",
        "default_domain": "utlyze_core"
      },
      {
        "id": "org_vuplicity",
        "name": "vuplicity",
        "description": "Vuplicity background check platform",
        "default_domain": "vuplicity"
      }
    ],
    "repos": [
      {
        "id": "repo_wrath_shield",
        "full_name": "CryptoJym/wrath-shield-v3",
        "description": "Life OS - manipulation detection, semantic memory, and coaching engine.",
        "default_domain": "utlyze_core",
        "sensitivity": "high"
      },
      {
        "id": "repo_fcra_matrix",
        "full_name": "CryptoJym/fcra-compliance-matrix",
        "description": "FCRA compliance matrix and rules engine.",
        "default_domain": "vuplicity",
        "sensitivity": "high_compliance"
      },
      {
        "id": "repo_ceoofone",
        "full_name": "h3ro-dev/ceoofone",
        "description": "CEO of One - Executive AI agent.",
        "default_domain": "utlyze_core"
      },
      {
        "id": "repo_vcofone",
        "full_name": "h3ro-dev/vcofone",
        "description": "VC of One - Investment AI agent.",
        "default_domain": "utlyze_core"
      },
      {
        "id": "repo_lawyerofone",
        "full_name": "h3ro-dev/lawyerofone",
        "description": "Lawyer of One - Legal AI agent.",
        "default_domain": "utlyze_core"
      },
      {
        "id": "repo_cro_compass",
        "full_name": "h3ro-dev/cro-revenue-compass",
        "description": "CRO of One - Revenue optimization agent.",
        "default_domain": "utlyze_core"
      },
      {
        "id": "repo_vuplicity_api",
        "full_name": "vuplicity/vuplicity-api",
        "description": "Vuplicity backend API.",
        "default_domain": "vuplicity",
        "sensitivity": "high_compliance"
      },
      {
        "id": "repo_vuplicity_hr",
        "full_name": "vuplicity/vuplicity-hr-portal",
        "description": "Vuplicity HR-facing portal.",
        "default_domain": "vuplicity",
        "sensitivity": "high_compliance"
      },
      {
        "id": "repo_vuplicity_employee",
        "full_name": "vuplicity/vuplicity-employee-portal",
        "description": "Vuplicity candidate-facing consent/dispute portal.",
        "default_domain": "vuplicity",
        "sensitivity": "high_compliance"
      },
      {
        "id": "repo_kahoa_roadmap",
        "full_name": "CryptoJym/kahoa-roadmap",
        "description": "Kahoa roadmap documentation.",
        "default_domain": "kahoa"
      },
      {
        "id": "repo_solutionstream_site",
        "full_name": "CryptoJym/solutionstream-site",
        "description": "SolutionStream website.",
        "default_domain": "solutionstream"
      }
    ]
  },
  "domain_mappings": [
    {
      "id": "mapping_utlyze_core",
      "domains": ["utlyze_core"],
      "github_repos": ["repo_wrath_shield", "repo_ceoofone", "repo_vcofone", "repo_lawyerofone", "repo_cro_compass"],
      "auto_create_issue": true,
      "sync_labels": true,
      "notes": "Primary development repos for Utlyze and Of One ecosystem"
    },
    {
      "id": "mapping_vuplicity",
      "domains": ["vuplicity"],
      "github_repos": ["repo_fcra_matrix", "repo_vuplicity_api", "repo_vuplicity_hr", "repo_vuplicity_employee"],
      "auto_create_issue": true,
      "sync_labels": true,
      "sensitivity_level": "high_compliance",
      "require_approval_for": ["delete", "close_milestone", "change_assignee"],
      "notes": "High-compliance domain - FCRA regulated"
    },
    {
      "id": "mapping_solutionstream",
      "domains": ["solutionstream"],
      "github_repos": ["repo_solutionstream_site"],
      "auto_create_issue": true,
      "sync_labels": false,
      "notes": "Client work and initiatives"
    },
    {
      "id": "mapping_kahoa",
      "domains": ["kahoa"],
      "github_repos": ["repo_kahoa_roadmap"],
      "auto_create_issue": true,
      "sync_labels": false,
      "notes": "Kahoa training programs and AI infrastructure"
    }
  ],
  "sync_rules": {
    "default_sync_interval_minutes": 30,
    "github_status_mapping": {
      "closed": "done",
      "open": "in_progress"
    },
    "github_priority_labels": {
      "urgent": ["urgent", "critical"],
      "high": ["high", "priority"],
      "low": ["low"]
    }
  }
}
