  "project_mappings": [
    {
      "id": "mapping_utlyze_core",
      "domains": ["utlyze_core"],
      "motion_workspace_id": "ws_utlyze",
      "motion_projects": ["Utlyze Core", "Of One Ecosystem"],
      "github_repos": ["repo_wrath_shield", "repo_ceoofone", "repo_vcofone", "repo_lawyerofone", "repo_cro_compass"],
      "direction": "bidirectional",
      "auto_create_issue": true,
      "auto_create_task": true,
      "sync_status": true,
      "sync_labels": true
    },
    {
      "id": "mapping_vuplicity",
      "domains": ["vuplicity"],
      "motion_workspace_id": "ws_vuplicity",
