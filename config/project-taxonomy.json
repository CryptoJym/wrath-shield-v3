  "hierarchy_types": {
    "root_project": {
      "description": "Standalone project with its own purpose, users, and roadmap",
      "criteria_threshold": 3,
      "criteria": [
        "Defines a standalone purpose",
        "Supports external customers or users",
        "Has (or will have) a roadmap",
        "Is monetized or operationally critical",
        "Contains multiple components or dependencies"
      ]
    },
    "sub_project": {
      "description": "Component that exists to support a parent project",
      "criteria_threshold": 3,
      "criteria": [
        "Exists to support a parent project",
        "Cannot function without its parent",
        "Has no independent customers",
        "Relies on the parent roadmap",
        "Is internal infrastructure, data pipeline, agent, or shared lib"
      ]
    },
    "orphan": {
      "description": "Repo with unclear purpose or no known parent - placed in R&D division",
      "criteria": [
        "Purpose is unclear",
        "Is an experiment/spike",
        "Has no known parent",
        "In progress with no roadmap",
        "Doesn't clearly fit any business unit"
      ],
      "default_placement": "rd",
      "requires_clarity_task": true
    }
  },

  "agent_actions": {
    "classification": [
      "assign_business_unit",
      "classify_as_root_project",
      "classify_as_sub_project",
      "mark_as_orphan"
    ],
    "domain": [
      "set_domain",
      "reclassify_domain"
    ],
    "hierarchy": [
      "set_parent",
      "remove_parent",
      "promote_orphan_to_project",
      "demote_root_to_subproject",
      "merge_projects"
    ],
    "maintenance": [
      "archive_project",
      "unarchive_project",
      "rename_project",
      "create_clarity_task"
    ],
    "automation": [
      "sync_repo_metadata",
      "sync_mcp_context",
      "generate_structure_documentation",
      "update_project_dashboard",
      "link_child_repos"
    ]
  },

