# HYRO Memory Layer Configuration
# Copy to .env and fill in your values

# =============================================================================
# MODE SELECTION
# =============================================================================
# Options: "cloud", "local", or "hybrid"
#   - cloud:  Uses OpenAI for LLM and embeddings (default)
#   - local:  Uses Ollama for both - fully offline, no API costs
#   - hybrid: Ollama embeddings + OpenAI LLM (cheaper embeddings)
MEM0_MODE=local

# =============================================================================
# QDRANT VECTOR DATABASE (Required - runs in Docker)
# =============================================================================
# Start with: docker-compose up -d qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# =============================================================================
# CLOUD MODE - OpenAI Configuration
# =============================================================================
# Required if MEM0_MODE=cloud or MEM0_MODE=hybrid
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# =============================================================================
# LOCAL MODE - Ollama Configuration
# =============================================================================
# Required if MEM0_MODE=local or MEM0_MODE=hybrid
# Make sure Ollama is running: ollama serve
OLLAMA_BASE_URL=http://localhost:11434

# LLM Options (December 2025 - ranked by performance):
#   - qwen3:8b          (Recommended - best reasoning, dual-mode thinking)
#   - deepseek-r1:8b    (Alternative - MIT license, distilled from 671B)
#   - llama3.1:8b       (Baseline - proven, stable)
OLLAMA_MODEL=qwen3:8b

# Embedding Options (December 2025 - ranked by accuracy):
#   - bge-m3            (Recommended - 72% accuracy, 1024 dims, multi-function)
#   - mxbai-embed-large (Alternative - state-of-the-art large embeddings)
#   - nomic-embed-text  (Baseline - good balance, 768 dims)
OLLAMA_EMBED_MODEL=bge-m3

# Embedding dimensions (bge-m3 uses 1024, nomic-embed-text uses 768)
EMBEDDING_DIMS=1024

# =============================================================================
# OPTIONAL: Neo4j Graph Database (for Graphiti temporal knowledge graphs)
# =============================================================================
# Uncomment and configure to enable graph-based memory
# Start with: docker-compose up -d neo4j
# NEO4J_URL=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=hyro_memory_2024
