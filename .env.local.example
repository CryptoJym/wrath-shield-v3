# WHOOP API v2 OAuth2 Configuration
WHOOP_CLIENT_ID=your_whoop_client_id_here
WHOOP_CLIENT_SECRET=your_whoop_client_secret_here
WHOOP_REDIRECT_URI=http://localhost:4242/api/whoop/oauth/callback

# Limitless Pendant API (optional until configured via UI)
LIMITLESS_API_KEY=

# OpenRouter API for Grok-4
OPENROUTER_API_KEY=your_openrouter_key_here

# OpenAI API for Mem0 embeddings
OPENAI_API_KEY=your_openai_key_here

# Database Encryption Key (32 bytes base64-encoded)
# Generate with: openssl rand -base64 32
DATABASE_ENCRYPTION_KEY=your_32_byte_base64_key_here

# Qdrant Vector Database (optional - defaults to localhost)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Agentic Grok (local service)
AGENTIC_GROK_URL=http://localhost:8001
XAI_API_KEY=your_xai_api_key_here
NEXT_PUBLIC_AGENTIC_GROK_URL=http://localhost:8001
# Override default model (defaults to grok-4-1-fast-reasoning-latest)
AGENTIC_MODEL=grok-4-1-fast-reasoning-latest

# Secondary context-enricher model (OpenRouter)
SECONDARY_MODEL=openai/gpt-5.1
# OPENROUTER_API_KEY=put_your_openrouter_key_here

# Motion (direct API)
MOTION_API_KEY=
MOTION_API_BASE=https://api.usemotion.com/v1
MOTION_WORKSPACE_ID=
# Optional JSON map for per-project routing, e.g. {"utlyze":"p72RARqmKFxw_foc8aKSi","new_reward":"ws_RPBtzsaxEy3r9MjxMKCYhy","default":"EXEdCAxOmv7XpFAaW6Tcn"}
MOTION_WORKSPACE_MAP=

# Gmail OAuth per mailbox (use npm run gmail:refresh; stores with suffixes)
# Example keys written: GMAIL_REFRESH_TOKEN_james_jamesbrady_org, GMAIL_CLIENT_ID_james_jamesbrady_org, GMAIL_CLIENT_SECRET_james_jamesbrady_org
GMAIL_CLIENT_SECRET_PATH=./client_secret.json

# Sherlock / task extraction model (XAI Grok)
ANALYSIS_MODEL=xai/grok-4-1-fast

# SMTP (for executors email send)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional: restrict outbound domain (e.g., @yourcompany.com)
# SMTP_ALLOW_DOMAIN=@example.com
# Multi-profile SMTP (JSON). Example:
# SMTP_PROFILES=[{"name":"universal","host":"smtp.gmail.com","port":587,"user":"James@jamesbrady.org","pass":"xxxx","from":"James Brady <James@jamesbrady.org>","domains":["jamesbrady.org","noticingmind.com"]},{"name":"utlyze","host":"smtp.office365.com","port":587,"user":"James@utlyze.com","pass":"xxxx","from":"James @ Utlyze <James@utlyze.com>","domains":["utlyze.com"]},{"name":"vuplicity","host":"smtp.office365.com","port":587,"user":"James@vuplicity.com","pass":"xxxx","from":"James @ Vuplicity <James@vuplicity.com>","domains":["vuplicity.com"]}]
# SMTP_DEFAULT_PROFILE=universal

# Twilio (optional SMS path)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM=+15551234567

# Streamlit EEG dashboard (embedded at /eeg)
NEXT_PUBLIC_STREAMLIT_URL=http://localhost:8501

# Sherlock / Task extraction model (set to Grok 4 Fast for 2M token context)
ANALYSIS_MODEL=x-ai/grok-4-fast

# Clerk Auth (set both to enable gating; otherwise auth is bypassed)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
