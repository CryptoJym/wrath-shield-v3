    },
    "motivational": {
      "description": "Reinforcing engagement and persistence",
      "typical_duration_range": [1, 5],
      "primary_effect": "motivation"
    },
    "physiological": {
      "description": "Physical state regulation interventions",
      "typical_duration_range": [1, 5],
      "primary_effect": "arousal_regulation"
    }
  },
  "trigger_definitions": {
    "success_streak": {
      "description": "Consecutive correct responses",
      "data_type": "integer",
      "typical_threshold": 3
    },
    "confidence": {
      "description": "Learner's self-reported or inferred confidence level",
      "data_type": "float",
      "range": [0, 1]
    },
