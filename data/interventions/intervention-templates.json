    },
    "abstraction": {
      "description": "Extracting general principles from specifics",
      "typical_duration_range": [10, 20],
      "primary_effect": "generalization"
    },
    "application": {
      "description": "Applying knowledge to real contexts",
      "typical_duration_range": [15, 30],
