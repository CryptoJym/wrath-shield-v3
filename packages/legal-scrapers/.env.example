# ===== LEGAL ADVOCATE AI CONFIGURATION =====

# Environment (development, production, testing)
ENVIRONMENT=development

# Database
# Development (SQLite)
DATABASE_URL=sqlite:///~/.legal_advocate_ai/action_items.db
# Production (PostgreSQL)
# DATABASE_URL=postgresql://user:pass@localhost:5432/legal_advocate

# Security
SECRET_KEY=your_secret_key_change_in_production
API_KEY=your_secure_api_key_here

# MyCase Credentials
MYCASE_USERNAME=your_username
MYCASE_PASSWORD=your_password
MYCASE_PORTAL_URL=https://your-firm.mycase.com

# Gmail API Credentials (OAuth)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# SendGrid (for alerts)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@example.com

# Admin email for notifications
ADMIN_EMAIL=admin@example.com

# Ollama Local AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# ChromaDB
CHROMA_PERSIST_DIR=~/.legal_advocate_ai/chroma

# Sentry Error Tracking (Production)
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# CORS Origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Background Jobs
SCHEDULER_ENABLED=true
ALERT_CHECK_INTERVAL_MINUTES=15

# Gunicorn (Production)
WEB_CONCURRENCY=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_TIMEOUT=120

# ===== TASKMASTER AI API KEYS =====
# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional, for OpenAI models. Format: sk-proj-...
GOOGLE_API_KEY="your_google_api_key_here"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="your_mistral_key_here"               # Optional, for Mistral AI models.
XAI_API_KEY="YOUR_XAI_KEY_HERE"                       # Optional, for xAI AI models.
GROQ_API_KEY="YOUR_GROQ_KEY_HERE"                     # Optional, for Groq models.
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY_HERE"         # Optional, for OpenRouter models.
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY="your_ollama_api_key_here"             # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY="your_github_api_key_here"             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...