{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "services": [
    {
      "name": "legal-advocate-api",
      "dockerfile": "Dockerfile",
      "healthcheckPath": "/health",
      "healthcheckTimeout": 30,
      "envVars": [
        "ENVIRONMENT",
        "DATABASE_URL",
        "SECRET_KEY",
        "API_KEY",
        "SENDGRID_API_KEY",
        "SENDGRID_FROM_EMAIL",
        "ADMIN_EMAIL",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "CORS_ORIGINS",
        "LOG_LEVEL",
        "WEB_CONCURRENCY",
        "WORKER_TIMEOUT"
      ]
    },
    {
      "name": "legal-advocate-dashboard",
      "dockerfile": "Dockerfile.dashboard",
      "healthcheckPath": "/_stcore/health",
      "healthcheckTimeout": 30,
      "envVars": [
        "API_BASE_URL",
        "API_KEY"
      ]
    }
  ],
  "databases": [
    {
      "type": "postgresql",
      "name": "legal-advocate-db",
      "plan": "hobby"
    }
  ]
}
